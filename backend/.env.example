# Copy to .env for local (non-docker) runs. Inside docker-compose most of these
# are overridden by docker-compose.yml's `environment:` block for the backend service.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# Database (docker-compose sets DATABASE_URL itself; used for local `prisma` CLI runs)
DATABASE_URL=postgresql://rentaj:rentaj_dev_password@localhost:5432/rentaj?schema=public

# Redis (cache + BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_REFRESH_EXPIRES_IN=30d
SESSION_REMEMBER_ME_DAYS=30

# Google OAuth (register a client at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# 2FA (admin only)
TWO_FACTOR_APP_NAME=Rentaj

# Mail (MailDev in docker-compose; swap for a real transactional provider in prod,
# e.g. SendGrid/Mailgun/Postmark SMTP credentials)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Rentaj
MAIL_FROM_ADDRESS=no-reply@rentaj.rs

# Uploads
UPLOADS_DIR=uploads
UPLOADS_BASE_URL=http://localhost:3001/uploads
MAX_PHOTO_SIZE_MB=8
MAX_PHOTOS_PER_LISTING=20

# Geocoding (dev default: Nominatim/OpenStreetMap, no key needed)
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# Payments (Banca Intesa e-commerce) — MOCK provider used until real credentials
# are confirmed (see Product Bible open items O22/O23). Swap PAYMENT_PROVIDER=banca_intesa
# once tokenization + recurring charges are contracted.
PAYMENT_PROVIDER=mock
BANCA_INTESA_MERCHANT_ID=
BANCA_INTESA_SECRET_KEY=
BANCA_INTESA_API_URL=

# Fiscalization / e-Invoice (Sparkom VP)
FISCALIZATION_PROVIDER=mock
SPARKOM_VP_API_KEY=
SPARKOM_VP_API_URL=

# IPS QR — generated locally per NBS spec, no external service required.

# Anti-bot
ANTI_BOT_HONEYPOT_FIELD=website
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Admin bootstrap (seed script)
ADMIN_SEED_EMAIL=admin@rentaj.rs
ADMIN_SEED_PASSWORD=ChangeMe123!
