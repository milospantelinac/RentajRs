# Copy to .env for local (non-docker) runs. Inside docker-compose most of these
# are overridden by docker-compose.yml's `environment:` block for the backend service.

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# Database (docker-compose sets DATABASE_URL itself; used for local `prisma` CLI runs)
DATABASE_URL=postgresql://rentaj:rentaj_dev_password@localhost:5432/rentaj?schema=public

# Redis (cache + BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_REFRESH_EXPIRES_IN=30d
SESSION_REMEMBER_ME_DAYS=30

# Google OAuth (register a client at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# 2FA (admin only)
TWO_FACTOR_APP_NAME=Rentaj

# Mail. Dev: MailDev from docker-compose (inbox at http://localhost:1080).
# Production: Postmark over SMTP. SMTP_USER/SMTP_PASS are the Access Key and
# Secret Key of an SMTP token (Postmark server > Default Transactional Stream >
# Settings), and Postmark only accepts MAIL_FROM_ADDRESS once the rentaj.rs
# domain is verified there (DKIM + Return-Path). With a login set, STARTTLS
# is required, so SMTP_SECURE stays false on 587.
#   SMTP_HOST=smtp.postmarkapp.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<Access Key>
#   SMTP_PASS=<Secret Key>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Rentaj
MAIL_FROM_ADDRESS=no-reply@rentaj.rs

# Uploads (T143). Locally nothing needs setting: pictures and attachments are
# kept on disk under UPLOADS_DIR (media/ and private/) and this backend serves
# them at http://localhost:<PORT>/media/. On the server they go to Hetzner
# Object Storage: STORAGE_DRIVER=s3 and the S3_* values below (two buckets,
# the public one with visibility "public", the private one "private").
UPLOADS_DIR=uploads
MAX_PHOTO_SIZE_MB=8
MAX_PHOTOS_PER_LISTING=20
STORAGE_DRIVER=local
# Where browsers read public pictures from. Unset: this backend's /media/
# locally, the public bucket's own address with s3
# (https://<S3_PUBLIC_BUCKET>.fsn1.your-objectstorage.com).
MEDIA_BASE_URL=
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# true only for a store that cannot take bucket names in the hostname; Hetzner can.
S3_FORCE_PATH_STYLE=false

# Geocoding (dev default: Nominatim/OpenStreetMap, no key needed)
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# iCal feed addresses on loopback/private/link-local hosts are refused (SSRF).
# Unset: allowed unless NODE_ENV=production, so local tests can use 127.0.0.1.
# Set false on any internet-facing server that doesn't run NODE_ENV=production.
# ICAL_ALLOW_PRIVATE_ADDRESSES=false

# Payments — recurring/renewal charges (subscription auto-renew, dunning retries)
# still go through this mock provider; see PaymentProvider interface for why
# (NestPay's 3D Pay Hosting is a one-time browser-redirect flow, not a
# server-initiated recharge API). Card checkout (buying a package) uses the
# real Banca Intesa NestPay integration below, configured by admins at
# /admin/placanje — not through these env vars.
PAYMENT_PROVIDER=mock

# 32-byte key (base64 or hex) used to encrypt NestPay Store Key / API password
# at rest in PaymentSettings. Generate with: openssl rand -base64 32
PAYMENT_ENCRYPTION_KEY=change_me_32_byte_base64_key_dev_only

# Fiscalization / e-Invoice (Sparkom VP)
FISCALIZATION_PROVIDER=mock
SPARKOM_VP_API_KEY=
SPARKOM_VP_API_URL=

# IPS QR — generated locally per NBS spec, no external service required.

# Anti-bot
ANTI_BOT_HONEYPOT_FIELD=website
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Admin bootstrap (seed script)
ADMIN_SEED_EMAIL=admin@rentaj.rs
ADMIN_SEED_PASSWORD=ChangeMe123!
