# Copy to .env for local (non-docker) runs. In docker-compose most of these
# are overridden by docker-compose.yml's `environment:` block for the frontend
# service.

# Reachable from the visitor's browser.
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
NUXT_PUBLIC_SITE_URL=https://rentaj.rs

# Server-side/SSR fetches (this process itself, not the visitor's browser).
# For local non-docker runs this is the same host as NUXT_PUBLIC_API_BASE;
# docker-compose.yml overrides it to http://backend:3001/api/v1 so the
# frontend container reaches the backend container by its service name.
NUXT_API_BASE_INTERNAL=http://localhost:3001/api/v1

# Google Maps JS API key for the search map / listing location picker
# (browser-exposed — restrict it to rentaj.rs + localhost in the Google Cloud console).
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
