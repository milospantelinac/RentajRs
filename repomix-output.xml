            <div class="checkout-summary-row mb-2">
              <span class="text-body">{{ pkg.key }} — {{ cycle === 'YEARLY' ? t('billing.yearly') : t('billing.monthly') }}</span>
              <span class="text-body checkout-summary-price">{{ formatPrice(priceForCycle) }}</span>
