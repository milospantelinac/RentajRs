  @ApiPropertyOptional()
  @IsOptional()
  @IsInt()
  @Min(1)
  maxDuration?: number;

  @ApiPropertyOptional()
  @IsOptional()
  @IsInt()
  @Min(1)
  minGuests?: number;

  @ApiPropertyOptional()
  @IsOptional()
  @IsInt()
  @Min(1)
  maxGuests?: number;

  @ApiPropertyOptional()
  @IsOptional()
  @IsInt()
  @Min(0)
  gapAfterMinutes?: number;

  @ApiPropertyOptional({ example: '14:00' })
  @IsOptional()
  @undefinedIfBlank
  @Matches(/^([01]\d|2[0-3]):[0-5]\d$/, { message: 'validation.TIME_INVALID' })
