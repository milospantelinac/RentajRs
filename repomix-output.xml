      {{ busy ? t('common.loading') : t('common.save') }}
    </button>
    <p v-if="saved" class="text-success mt-2">{{ t('dashboard.changesSaved') }}</p>
    <p v-if="editorError" class="form-error mt-2">{{ editorError }}</p>



