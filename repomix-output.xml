  ) {
    return this.listingsService.addPhoto(userId, id, file);
  }

  @Delete('listings/:id/photos/:photoId')
  removePhoto(@CurrentUser('id') userId: string, @Param('id') id: string, @Param('photoId') photoId: string) {
