            {{ ok ? '✓' : '✗' }} {{ t(`listing.checklist.${key}`) }}
            <NuxtLink v-if="!ok && key === 'hasPhone'" to="/kontrolna-tabla/podesavanja">{{ t('common.edit') }} →</NuxtLink>


