  }

  @Patch('listings/:id/photos/reorder')
  reorderPhotos(@CurrentUser('id') userId: string, @Param('id') id: string, @Body('photoIds') photoIds: string[]) {
    return this.listingsService.reorderPhotos(userId, id, photoIds);
