                  <button
                    v-for="tag in guestTags"
                    :key="tag"
                    type="button"
                    class="btn btn-sm"
                    :class="reviewForm.tags.includes(tag) ? 'btn-primary-flat' : 'btn-tertiary'"
                    @click="toggleTag(tag)"
                  >{{ t(`reviews.tags.${tag}`) }}</button>
