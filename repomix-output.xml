<file path="frontend/assets/scss/_breakpoints.scss">
@use 'sass:map';

$breakpoint-xs: 0;
$breakpoint-sm: 576px;
$breakpoint-md: 768px;
$breakpoint-lg: 992px;
$breakpoint-xl: 1200px;
$breakpoint-xxl: 1400px;

$breakpoints: (
  xs: $breakpoint-xs,
  sm: $breakpoint-sm,
  md: $breakpoint-md,
  lg: $breakpoint-lg,
  xl: $breakpoint-xl,
  xxl: $breakpoint-xxl,
);

@mixin respond-above($name) {
  $value: map.get($breakpoints, $name);
  @if $value == 0 {
    @content;
  } @else {
    @media (min-width: $value) {
      @content;
    }
  }
}

@mixin respond-below($name) {
  $value: map.get($breakpoints, $name);
  @media (max-width: ($value - 0.02px)) {
    @content;
  }
}

@mixin respond-between($lower, $upper) {
  $lower-value: map.get($breakpoints, $lower);
  $upper-value: map.get($breakpoints, $upper);
  @media (min-width: $lower-value) and (max-width: ($upper-value - 0.02px)) {
    @content;
  }
}



@mixin mobile-only {
  @include respond-below(md) {
    @content;
  }
}
</file>

