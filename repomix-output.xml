function slugify(input) {
    const map = {
        č: 'c',
        ć: 'c',
        ž: 'z',
        š: 's',
        đ: 'dj',
        Č: 'c',
        Ć: 'c',
        Ž: 'z',
        Š: 's',
        Đ: 'dj',
    };
    return input
        .split('')
        .map((ch) => map[ch] ?? ch)
        .join('')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
}
function opts(names) {
    return names.map((name) => ({ key: slugify(name), name }));
}
