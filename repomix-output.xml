            </button>


            <button v-if="booking.status === 'AWAITING_PAYMENT' && disputePaymentAvailable" class="btn btn-tertiary" @click="act('dispute-payment')">
              {{ t('booking.reportUnpaidConfirmed') }}
            </button>
